---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Tell us how you have used FAIR">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-serif mb-6 text-ink">Tell us how you have used FAIR</h1>
    <p class="text-lg text-ink-secondary mb-8">
      If FAIR has informed a conversation, policy, strategy, initiative, research activity or other change within your organisation, please tell us. Your response will help us understand the reach and impact of the work.
    </p>

    <!-- Tall form link-->
    <div class="w-full h-[800px] border border-border rounded-lg overflow-hidden bg-surface">
      <iframe 
        src="https://tally.so/r/0Vdvoj"
        width="100%" 
        height="100%" 
        frameborder="0" 
        style="border:none;">
      </iframe>
    </div>
  </section>
</BaseLayout>