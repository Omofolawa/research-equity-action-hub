---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Get Involved">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-serif mb-6 text-ink">Get involved</h1>
    <p class="text-lg text-ink-secondary mb-8">
      We welcome enquiries from individuals and organisations interested in using the FAIR findings and recommendations, supporting implementation, developing collaborations or engaging with the wider research equity agenda.
    </p>

        <!-- Tally Form -->
    <div class="w-full h-[800px] border border-border rounded-lg overflow-hidden bg-surface">
      <iframe 
        src="https://tally.so/r/Ge6DYK" 
        width="100%" 
        height="100%" 
        frameborder="0" 
        style="border:none;">
      </iframe>
    </div>
  </section>
</BaseLayout>