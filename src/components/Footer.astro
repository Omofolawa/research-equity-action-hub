---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="border-t border-border mt-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 text-sm text-ink-secondary">
    <p class="font-serif text-base text-ink mb-2">
      Research Equity Action Hub
    </p>
    <p class="mb-4">Home of the FAIR Nursing Study · University of Staffordshire</p>
    <p class="mb-6 max-w-2xl">
      Supported by UK Research and Innovation (UKRI) and the British Academy through the
      Equality, Diversity and Inclusion Caucus (EDICA).
    </p>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-4">
        <li><a href={base + '/get-involved'}>Contact</a></li>
        <li><a href={base + '/privacy'}>Privacy notice</a></li>
        <li><a href={base + '/accessibility'}>Accessibility statement</a></li>
        <li><a href={base + '/cookies'}>Cookie information</a></li>
      </ul>
    </nav>
    <p class="mt-8 text-xs text-ink-secondary">© {year} FAIR Nursing Study</p>
  </div>
</footer>